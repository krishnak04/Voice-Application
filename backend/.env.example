# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_HISTORY_MESSAGES=50

# Faster-Whisper Configuration
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
CALL_FINAL_WHISPER_MODEL=base.en
CALL_TRAILING_SILENCE_SECONDS=1.2
CALL_VAD_MIN_RMS=0.003
CALL_VAD_MIN_PEAK=0.008
CALL_VAD_NOISE_MULTIPLIER=1.8
CALL_VAD_START_FRAMES=2
CALL_VAD_MIN_SPEECH_MS=120
CALL_VAD_MIN_SPEECH_BAND_RATIO=0.15
CALL_VAD_MAX_SPECTRAL_FLATNESS=0.95
# Exact one-token decoder artifacts suppressed before dispatching to Groq.
STT_HALLUCINATION_SINGLE_WORDS=ACT,DEAD

# Server Host and Port
HOST=0.0.0.0
PORT=8024
